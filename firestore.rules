rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check / test connection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Drug catalog & inventory
    match /drugs/{drugId} {
      allow read: if true;
      allow write: if true;
    }

    // Prescription & medicine orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Doctor consultations & telehealth appointments
    match /consultations/{consultationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Supplier accounts payable ledger
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
