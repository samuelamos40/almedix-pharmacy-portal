{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Patient, Pharmacist, and Staff profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "admin", "accounts_officer", "data_analyst"] },
        "title": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "allergies": { "type": "string" },
        "employeeId": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "avatarInitials": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "drugs": {
      "title": "Pharmaceutical Item",
      "description": "Dispensed and over-the-counter medicine inventory record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "genericName": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "dosageForm": { "type": "string" },
        "strength": { "type": "string" },
        "packSize": { "type": "string" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stockLevel": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "requiresPrescription": { "type": "boolean" },
        "nafdacNumber": { "type": "string" },
        "manufacturer": { "type": "string" },
        "batchNumber": { "type": "string" },
        "expiryDate": { "type": "string" },
        "storageCondition": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "sellingPrice", "stockLevel"]
    },
    "orders": {
      "title": "Prescription Order",
      "description": "Patient medication order placed online or at dispensary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryCity": { "type": "string" },
        "orderDate": { "type": "string" },
        "orderStatus": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerEmail", "totalAmount"]
    },
    "consultations": {
      "title": "Telehealth Appointment",
      "description": "Doctor or clinical pharmacist teleconsultation booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appointmentNumber": { "type": "string" },
        "patientName": { "type": "string" },
        "patientAge": { "type": "number" },
        "patientGender": { "type": "string" },
        "patientPhone": { "type": "string" },
        "patientEmail": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "appointmentTime": { "type": "string" },
        "specialistType": { "type": "string" },
        "consultationFormat": { "type": "string" },
        "symptomsSummary": { "type": "string" },
        "status": { "type": "string" },
        "fee": { "type": "number" },
        "bookedAt": { "type": "string" }
      },
      "required": ["id", "appointmentNumber", "patientName", "patientPhone", "specialistType"]
    },
    "invoices": {
      "title": "Supplier Payable Invoice",
      "description": "Wholesale pharmaceutical supplier payable liabilities record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierContact": { "type": "string" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "drugName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "quantityReceived": { "type": "number" },
        "totalPayable": { "type": "number" },
        "amountPaid": { "type": "number" },
        "outstandingBalance": { "type": "number" },
        "status": { "type": "string" },
        "currency": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "supplierName", "totalPayable", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Stores user profiles for patients and pharmacy staff"
    },
    "/drugs/{drugId}": {
      "schema": "drugs",
      "description": "Medication catalog and real-time inventory"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Patient prescription orders"
    },
    "/consultations/{consultationId}": {
      "schema": "consultations",
      "description": "Doctor appointments and telepharmacy bookings"
    },
    "/invoices/{invoiceId}": {
      "schema": "invoices",
      "description": "Supplier accounts payable records"
    }
  }
}
